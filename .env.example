# API base URL. Use the relative path when the API serves the client (same origin).
VITE_API_URL=/api/v1
# Canonical public origin, used for canonical, hreflang, Open Graph and sitemap URLs.
VITE_SITE_URL=https://aicvbuilderbd.online
# Optional: Google Sign-In OAuth client ID (Web). Leave empty to hide Google login.
VITE_GOOGLE_CLIENT_ID=
# Optional: GA4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=
