# Absolute API base URL (the API is hosted separately). In dev, "/api/v1" goes through
# the Vite proxy to localhost:5000 (override with API_PROXY_TARGET).
VITE_API_URL=/api/v1
# Canonical public origin, used for canonical, hreflang, Open Graph and sitemap URLs.
VITE_SITE_URL=https://aicvbuilderbd.online
# Optional: Google Sign-In OAuth client ID (Web). Leave empty to hide Google login.
VITE_GOOGLE_CLIENT_ID=
# Optional: GA4 measurement ID (G-XXXXXXXXXX). Loaded only after the visitor accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=
# Optional: Google AdSense publisher ID (ca-pub-...) and ad unit slot. Ads show on guides and job pages only,
# after the visitor accepts cookies; the build writes ads.txt and allows AdSense in the CSP.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
